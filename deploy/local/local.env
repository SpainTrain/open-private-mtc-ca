# MTC CA local dev environment — endpoint/env-var contract.
# Source into a shell before running services/tools against the local stack:
#   set -a; source deploy/local/local.env; set +a
# Full contract documentation: deploy/local/README.md

# --- AWS SDK / CLI -> LocalStack ---------------------------------------------
# The Rust AWS SDK and the AWS CLI both honor AWS_ENDPOINT_URL natively.
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# --- MTC data model (spec §8) ------------------------------------------------
# Local values for what production resolves from SSM Parameter Store
# (/mtc/<env>/<component>/<key> naming per the fnd-cdk-ssm-config-handoff
# contract; env vars override SSM in local dev, spec §4 config row).
MTC_LOG_BUCKET=mtc-log-local
MTC_COORDINATION_TABLE=mtc-log-coordination

# --- SoftHSM2 / PKCS#11 (spec §4 HSM dev row, §14) ---------------------------
# Module path is valid *inside* the softhsm container (docker compose exec
# softhsm ...). For a host-side SoftHSM2 install, override to your platform's
# libsofthsm2.so path (see README).
MTC_PKCS11_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
MTC_PKCS11_TOKEN_LABEL=mtc-dev
MTC_PKCS11_PIN=1234
MTC_PKCS11_KEY_LABEL=checkpoint-signing
