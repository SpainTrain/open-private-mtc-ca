# EditorConfig — https://editorconfig.org
# Coding style baseline shared by humans and agents across the repo's languages.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust (rustfmt default: 4-space indent, 100-col width)
[*.rs]
indent_size = 4
max_line_length = 100

# TypeScript / JavaScript (CDK app in infra/)
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# JSON (package.json, tsconfig, planning artifacts)
[*.json]
indent_size = 2

# YAML (CI workflows, compose, OpenAPI)
[*.{yml,yaml}]
indent_size = 2

# Markdown — two trailing spaces is a hard line break, so keep them
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Makefiles require real tabs
[{Makefile,*.mk}]
indent_style = tab

# Shell scripts
[*.sh]
indent_size = 2
